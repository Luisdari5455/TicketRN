{
  "expo": {
    "name": "TicketRN",
    "slug": "TicketRN",
    "version": "1.0.6",
    "orientation": "landscape",
    "icon": "./assets/icon-1024.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": { "enabled": false },
    "android": {
      "package": "com.tuempresa.ticketrn",
      "versionCode": 6,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": ["INTERNET", "WAKE_LOCK", "BLUETOOTH_CONNECT"],
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "allowBackup": false,
      "usesCleartextTraffic": true  
    },
    "ios": { "supportsTablet": true },
    "web": { "favicon": "./assets/icon-1024.png" },
    "extra": {
      "eas": { "projectId": "0bc0a0a4-3164-4acf-aeec-119f783d30d7" }
    },
    "plugins": [
      "./plugins/with-kiosk-native.js",
      "./plugins/with-immersive-mode.js"
    ]
  }
}
